NODE_ENV=development
PORT=4000

# Должно совпадать с docker-compose.yml в корне репозитория
DATABASE_URL=postgresql://expence:expence@localhost:5432/expence_tracker?schema=public

# Origin фронтенда — для CORS с credentials
WEB_ORIGIN=http://localhost:3000

# Минимум 32 символа. Для локальной разработки сгенерируйте свои:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string-32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Оставьте пустым для localhost
COOKIE_DOMAIN=
