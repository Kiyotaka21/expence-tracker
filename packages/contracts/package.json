{
  "name": "@expence/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Общие zod-схемы и типы DTO для web и api",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@expence/eslint-config": "workspace:*",
    "@expence/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
