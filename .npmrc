# Peer-зависимости резолвим автоматически и не падаем на несовпадениях мажоров
# (Nest/Next-экосистемы часто отстают с обновлением peer-диапазонов).
auto-install-peers=true
strict-peer-dependencies=false
# Плоский node_modules не нужен, но hoist для линтеров/типов упрощает жизнь IDE.
shamefully-hoist=false
